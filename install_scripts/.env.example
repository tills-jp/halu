#######################################################
# ユーザ任意の指定
#######################################################
# DBユーザ名・パスワード
DB_USERNAME=""
DB_PASSWORD=""

# 仮想サーバのユーザ名・パスワード
SRV_USERNAME=""
SRV_PASSWORD=""

# ファイアーウォールの設定方法(外部接続あり：yes、内部接続のみ：no)
ENABLE_FIREWALL=""
#######################################################

# 環境構築用パス
BASH_PROFILE="/home/$DB_USERNAME/.bash_profile"
BASHRC="/home/$DB_USERNAME/.bashrc"
CONF_FILE="/etc/ld.so.conf"

# ファイアウォール設定用パス(setup_env.shにて設定)
FIREWALL_PORTS=""
FIREWALL_SERVICES=""

# postgresqlの設定
DB_PORT="5432"
DB_NAME="sample"
# リストア用の一時DBユーザ（リストア完了後に削除される）
DB_BACKUP_USERNAME="postgres"
DB_BACKUP_PASSWORD="postgres"
# 管理者作成のユニットのため /etc/systemd/system 配下に置く
POSTGRE_SERVICE_FILE="/etc/systemd/system/postgresql.service"
POSTGRE_CONF="/usr/local/pgsql/data/postgresql.conf"
PG_HBA="/usr/local/pgsql/data/pg_hba.conf"
POSTGRE_DATA="/usr/local/postgresql-16.9/data"
POSTGRE_HOME="/home/$DB_USERNAME"

# 仮想サーバ(haluv)の設定
VENV_DIR="/home/$SRV_USERNAME/haluv"
VENV_BASH_FILE="/home/$SRV_USERNAME/.bash_profile"
VENV_BASHRC="/home/$SRV_USERNAME/.bashrc"
SRV_PORT="8000"
HALU_CONF="/home/$SRV_USERNAME/HaluServer/Halu/System/Server/Libraries/halumain/haluconf.py"

# 配布ソースの取得元（通常は変更不要）
# 動作確認などで別のソースを入れたい場合のみ変更する。
#   SOURCE_ZIP_URL  : ダウンロード元のzip。空欄または未指定なら本番リポジトリのmaster。
#   SOURCE_ZIP_FILE : 手元に用意したzipを使う場合のパス。指定するとダウンロードせずこちらを使う。
#                     （Privateリポジトリのzipをトークンで落として持ち込む場合など）
SOURCE_ZIP_URL="https://github.com/tills-jp/halu/archive/refs/heads/master.zip"
SOURCE_ZIP_FILE=""

