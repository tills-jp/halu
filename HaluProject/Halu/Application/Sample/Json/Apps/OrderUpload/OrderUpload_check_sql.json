         "     , CURRENT_TIMESTAMP",
         "  FROM 受注ＣＳＶ AS csv",
         "  LEFT OUTER JOIN 商品 AS prd ON (prd.商品コード = csv.商品コード AND prd.削除フラグ = '0')",
