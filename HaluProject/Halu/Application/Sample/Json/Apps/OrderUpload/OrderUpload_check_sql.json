    "sql": {
      "type": "insert",
      "freesql":
       [
         "INSERT INTO 受注ＣＳＶエラー (受注番号, 明細番号, 項目名, 項目値, エラー内容, 取込日時)",
         "SELECT csv.受注番号",
         "     , CAST(csv.明細番号 AS character varying)",
         "     , '顧客ＩＤ'",
         "     , CAST(csv.顧客ＩＤ AS character varying)",
         "     , '顧客マスタに登録されていない顧客ＩＤです。'",
         "     , CURRENT_TIMESTAMP",
         "  FROM 受注ＣＳＶ AS csv",
         "  LEFT OUTER JOIN 顧客 AS cst ON (cst.顧客ＩＤ = csv.顧客ＩＤ AND cst.削除フラグ = '0')",
         " WHERE cst.顧客ＩＤ IS NULL"
       ],
